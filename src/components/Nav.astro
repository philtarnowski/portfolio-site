---
import BibLogo from './BibLogo.astro'
import { caseStudies } from '../data/caseStudies'
---
<nav style="max-width: 1200px; margin: 0 auto; padding: 28px 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px">
  <a href="/" style="display: flex; align-items: center; gap: 12px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 24px; letter-spacing: 0.02em; color: #FFFFFF">
    <BibLogo />Phil Tarnowski
  </a>
  <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 28px; font-size: 15px; font-weight: 500">
    <div class="cs-dd" data-dropdown>
      <button type="button" class="cs-dd__button" aria-expanded="false" aria-haspopup="true" data-dropdown-button>
        Case Studies
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </button>
      <div class="cs-dd__menu">
        <div class="cs-dd__panel">
          {caseStudies.map((cs) => (
            <a class="cs-dd__item" href={cs.href}>
              <img src={cs.logo} alt="" style={`height: ${cs.logoHeight}px; width: auto; display: block; align-self: flex-start`} />
              <span>{cs.headline}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
    <a href="https://www.linkedin.com/in/philtarnowski/" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 10px; border: 2px solid #4AB8D4; color: #FFFFFF; font-weight: 600; padding: 10px 18px; border-radius: 10px">
      <span aria-hidden="true" style="width: 22px; height: 22px; border-radius: 5px; background: #4AB8D4; color: #0E0E10; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px; line-height: 1">in</span>Connect
    </a>
  </div>
</nav>

<script>
  // Click/tap toggles the Case Studies menu (hover and keyboard focus are handled in CSS).
  for (const dd of document.querySelectorAll('[data-dropdown]')) {
    const button = dd.querySelector('[data-dropdown-button]')
    if (!button) continue
    const setOpen = (open: boolean) => {
      dd.classList.toggle('is-open', open)
      button.setAttribute('aria-expanded', String(open))
    }
    button.addEventListener('click', (e) => {
      e.stopPropagation()
      setOpen(!dd.classList.contains('is-open'))
    })
    document.addEventListener('click', (e) => {
      if (!dd.contains(e.target as Node)) setOpen(false)
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false)
    })
  }
</script>
